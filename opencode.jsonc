{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "memory-mcp": {
        "type": "local",
        "command": [
          "D:\\memory-mcp-server\\.venv\\Scripts\\python.exe",
          "D:\\memory-mcp-server\\main.py"
        ],
        "cwd": "D:\\memory-mcp-server"
      }
    }
  },
  "permission": {
    "memory-mcp_*": "ask"
  }
}
